# Es la plantilla de las variables de configuración, con nombres y valores de mentira.
# Solo para que sepan qué variables deben crear

POSTGRES_USER=app
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=plantas
MONGO_INITDB_ROOT_USERNAME=app
MONGO_INITDB_ROOT_PASSWORD=cambiar_esta_clave
JWT_SECRET=cambiar_por_un_valor_largo_y_aleatorio
API_PORT=8000

# A7: contraseñas de las cuentas de PostgreSQL (db/06_roles.sql)
PG_PASS_ADMIN=cambiar_esta_clave
PG_PASS_API=cambiar_esta_clave
PG_PASS_REPORTES=cambiar_esta_clave
# Llave para el HMAC del correo en directorio_correo (la usa la API)
CORREO_HMAC_KEY=cambiar_por_un_valor_largo_y_aleatorio

# A11: cuenta de replicación entre nodos (db/08_rls_replicacion.sql)
PG_PASS_REPLICA=cambiar_esta_clave
# Nodo que escribe las tablas globales: norte, centro o sur (D-01 §4)
ESCRITOR_GLOBALES=norte
# Dirección de cada nodo. En el laboratorio: pg-norte, pg-centro, pg-sur.
# En las 3 computadoras: la IP de cada una en la VPN (C9).
NODO_NORTE_HOST=pg-norte
NODO_CENTRO_HOST=pg-centro
NODO_SUR_HOST=pg-sur
