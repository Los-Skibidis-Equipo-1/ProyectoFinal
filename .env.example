# Es la plantilla de las variables de configuración, con nombres y valores de mentira.
# Solo para que sepan qué variables deben crear

POSTGRES_USER=app
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=plantas
MONGO_INITDB_ROOT_USERNAME=app
MONGO_INITDB_ROOT_PASSWORD=cambiar_esta_clave
